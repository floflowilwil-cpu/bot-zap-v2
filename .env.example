# ==============================
# CONFIGURATION BOT WHATSAPP
# ==============================

# Clé API Anthropic (Claude AI)
# Obtenir sur : https://console.anthropic.com
ANTHROPIC_API_KEY=ta_cle_anthropic_ici

# Clé API Météo (OpenWeatherMap)
# Obtenir sur : https://openweathermap.org/api (gratuit)
OPENWEATHER_API_KEY=ta_cle_meteo_ici

# Clé API News
# Obtenir sur : https://newsapi.org (gratuit)
NEWS_API_KEY=ta_cle_news_ici

# Numéro admin du bot (format international sans +)
# Exemple : 237691234567 pour le Cameroun
ADMIN_NUMBER=237XXXXXXXXX

# Préfixe des commandes (par défaut !)
COMMAND_PREFIX=!

# Langue par défaut pour la météo
DEFAULT_CITY=Yaoundé
